{
  "name": "certifiks",
  "version": "0.1.0",
  "private": true,
  "description": "Engineering foundation for the CertiFiks verified-repair escrow protocol",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "workers/verifier",
    "packages/shared"
  ],
  "scripts": {
    "lint": "biome lint .",
    "format:check": "biome format .",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "build": "npm run build -ws --if-present",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "5.9.3",
    "tsx": "4.20.5",
    "@types/node": "22.18.10"
  }
}
