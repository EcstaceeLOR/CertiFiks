{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "bountyId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "attemptDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "reportDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "expected_failure",
            "unexpected_pass",
            "inconclusive"
          ]
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^0x[a-f0-9]{64}$"
        }
      },
      "required": [
        "status",
        "evidenceDigest"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "inconclusive"
          ]
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^0x[a-f0-9]{64}$"
        }
      },
      "required": [
        "status",
        "evidenceDigest"
      ]
    },
    "regressionsPassed": {
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "approved",
        "rejected",
        "inconclusive"
      ]
    },
    "signerOrganization": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "signerAccount": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256
    },
    "signatureScheme": {
      "enum": [
        "secp256k1",
        "ed25519"
      ]
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{128,130}$"
    },
    "expiresAtUnix": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    }
  },
  "required": [
    "version",
    "bountyId",
    "attemptId",
    "manifestDigest",
    "attemptDigest",
    "reportDigest",
    "imageDigest",
    "baseline",
    "candidate",
    "regressionsPassed",
    "verdict",
    "signerOrganization",
    "signerAccount",
    "signatureScheme",
    "signature",
    "expiresAtUnix"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://certifiks.dev/schemas/v1/verification-report.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "approved"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "baseline": {
            "properties": {
              "status": {
                "const": "expected_failure"
              }
            }
          },
          "candidate": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          },
          "regressionsPassed": {
            "const": true
          }
        }
      }
    }
  ]
}
