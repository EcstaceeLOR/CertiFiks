{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "bountyId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "baseCommitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "headCommitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "submittedAtUnix": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "developerAccount": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256
    },
    "pullNumber": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "bountyId",
    "attemptId",
    "repositoryId",
    "baseCommitSha",
    "headCommitSha",
    "manifestDigest",
    "submittedAtUnix",
    "developerAccount",
    "pullNumber",
    "imageDigest",
    "evidenceDigest"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:certifiks:protocol:v1:candidate-attempt"
}
