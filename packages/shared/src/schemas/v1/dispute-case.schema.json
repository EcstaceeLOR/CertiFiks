{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "bountyId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "openedBy": {
      "enum": [
        "sponsor",
        "developer"
      ]
    },
    "reasonDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "openedAtUnix": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "responseDeadlineUnix": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "escalationDeadlineUnix": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "status": {
      "enum": [
        "opened",
        "awaiting_response",
        "arbitrating",
        "escalated",
        "resolved_developer",
        "resolved_sponsor"
      ]
    }
  },
  "required": [
    "version",
    "bountyId",
    "attemptId",
    "openedBy",
    "reasonDigest",
    "evidenceDigest",
    "openedAtUnix",
    "responseDeadlineUnix",
    "escalationDeadlineUnix",
    "status"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:certifiks:protocol:v1:dispute-case"
}
